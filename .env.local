APP_ENV=dev
APP_RELEASE=local

POSTGRES_USER=fiber
POSTGRES_PASSWORD=fiberpass
POSTGRES_DB=fibercrm

# Used by docker-compose.yml backend service
BACKEND_DATABASE_URL=postgresql+asyncpg://fiber:fiberpass@db:5432/fibercrm

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ALLOW_ORIGINS=*
SQL_ECHO=false
SEED_DEMO_DATA=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_REPORT_PER_MINUTE=20
RATE_LIMIT_REALTIME_PER_MINUTE=120
MAX_UPLOAD_BYTES=2000000
