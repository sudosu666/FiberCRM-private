APP_ENV=prod
APP_RELEASE=2026.03.08

POSTGRES_USER=fiber
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=fibercrm

# Used by docker-compose.prod.yml backend service
DATABASE_URL=postgresql+asyncpg://fiber:replace_me@db:5432/fibercrm

JWT_SECRET=replace_with_strong_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ALLOW_ORIGINS=https://crm.example.com
SQL_ECHO=false
SEED_DEMO_DATA=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=prod
SENTRY_TRACES_SAMPLE_RATE=0.05

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_REPORT_PER_MINUTE=12
RATE_LIMIT_REALTIME_PER_MINUTE=90
MAX_UPLOAD_BYTES=300000

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
NGINX_HTTPS_PORT=8443
